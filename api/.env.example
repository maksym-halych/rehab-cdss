# Copy to .env and fill in. Each environment (dev, prod) has its own .env.

# --- Docker Compose (server only). Run Compose with --env-file api/.env ---
# Host port on 127.0.0.1 that Caddy proxies to: 8000 for dev, 8001 for prod
HOST_PORT=8000

# --- AI providers ---
# Gemini API key: chat models, and embeddings when EMBEDDING_PROVIDER=gemini
DIPLOMA_API_KEY=
# Needed only when EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# openai | gemini. Must match the provider that built data/chromadb (in the repo root)
EMBEDDING_PROVIDER=gemini
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# --- API access (Clerk) ---
# Clerk Frontend API URL. The API checks session tokens against it and does not start without it.
# Clerk Dashboard -> API keys. It is also the host encoded in the publishable key.
CLERK_ISSUER=https://simple-cicada-2857.clerk.accounts.dev
# Comma-separated frontend URLs for CORS and the token azp check, e.g. https://dev-rehab-cdss.notetaker.uk
CDSS_ALLOWED_ORIGINS=
